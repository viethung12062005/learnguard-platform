# LearnGuard — Multi-Stage Production Dockerfile for Frontend SPA & Reverse Proxy (FE-MLOPS)
# Build context = FE-MLOPS repository root.
# Build command:
#   docker build -f learnguard-platform/deploy/docker/Dockerfile.fe -t ghcr.io/<org>/learnguard-fe:<tag> ./FE-MLOPS

# ---------------------------------------------------------------------------
# Stage 1: Build static React + TypeScript bundle with Vite
# ---------------------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /build

ARG VITE_BACKEND_API_URL=/api
ARG VITE_USE_MOCK=false

ENV VITE_BACKEND_API_URL=${VITE_BACKEND_API_URL} \
    VITE_USE_MOCK=${VITE_USE_MOCK}

COPY package.json package-lock.json tsconfig.json index.html ./
RUN npm ci --no-audit --no-fund

COPY src ./src
RUN npm run build

# ---------------------------------------------------------------------------
# Stage 2: Nginx 1.27 Alpine runtime serving static assets + /api reverse proxy
# ---------------------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

LABEL org.opencontainers.image.title="learnguard-fe" \
      org.opencontainers.image.description="LearnGuard Advisor Dashboard SPA & Nginx Reverse Proxy" \
      org.opencontainers.image.source="https://github.com/ntk223/FE-MLOPS"

# Remove default nginx config and copy compiled Vite bundle
RUN rm -rf /usr/share/nginx/html/*
COPY --from=builder /build/dist /usr/share/nginx/html

# Provide a default single-container fallback config if /etc/nginx/conf.d/default.conf is not bind-mounted
RUN printf 'server {\n\
    listen 80;\n\
    server_name _;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    location = /healthz {\n\
        access_log off;\n\
        default_type text/plain;\n\
        return 200 "ok\\n";\n\
    }\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80 443

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O - http://127.0.0.1:80/healthz | grep -q "ok" || exit 1

CMD ["nginx", "-g", "daemon off;"]
