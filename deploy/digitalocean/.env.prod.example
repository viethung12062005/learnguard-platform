# =============================================================================
# LearnGuard — DigitalOcean Production Environment Template (.env.prod.example)
#
# Copy this file to `/opt/learnguard/deploy/digitalocean/.env` on the Droplet VM
# and set strict permissions:
#   chmod 600 /opt/learnguard/deploy/digitalocean/.env
#
# NEVER commit the real `.env` file to Git.
# =============================================================================

# --- 1. Container Images (Immutable @sha256 digests from GHCR) ----------------
LG_API_IMAGE=ghcr.io/viethung12062005/learnguard-api@sha256:2d232c5ca2f1d72c2f3f38347561f4490b57d7ac9f579747149f372ce7cc8a8c
LG_ML_IMAGE=ghcr.io/viethung12062005/learnguard-ml@sha256:5bfab2cccd13387214929faf3c05d4b9ea2e3d5f11c04e06fbc0a4006d09833f
LG_FE_IMAGE=ghcr.io/viethung12062005/learnguard-fe@sha256:1805e399bcadf79186e99545f0ebf0a353bd678e179ea4d503ac744efda6c63f

# --- 2. Persistent Data Mount Path on DigitalOcean Droplet -------------------
LG_DATA_ROOT=/opt/learnguard/data

# --- 3. Public HTTP/HTTPS Ports (Exposed via Nginx Frontend Container) --------
HTTP_PORT=80
HTTPS_PORT=443

# --- 3b. Optional TLS / HTTPS & Pre-Auth Configuration -----------------------
ENABLE_TLS=false
TLS_CERT_DIR=/opt/learnguard/certs
SERVER_NAME=_

# --- 4. PostgreSQL 16 Credentials & Least-Privilege Role Passwords ------------
POSTGRES_DB=learnguard
POSTGRES_ADMIN_USER=lgadmin
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_32_CHAR_RANDOM_ADMIN_PASSWORD
LG_API_PASSWORD=REPLACE_WITH_32_CHAR_RANDOM_API_ROLE_PASSWORD
LG_ML_WRITER_PASSWORD=REPLACE_WITH_32_CHAR_RANDOM_ML_WRITER_ROLE_PASSWORD

# --- 5. Backend Security & CORS Configuration --------------------------------
JWT_SECRET=REPLACE_WITH_64_HEX_CHAR_SECRET_FROM_OPENSSL_RAND_HEX_32
CORS_ORIGINS=https://learnguard.example.com,http://localhost

# --- 6. LLM Configuration (Primary OpenRouter + Local Ollama Fallback) --------
LLM_MODEL=openrouter/google/gemini-2.5-flash:free
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY

LLM_FALLBACK_MODEL=ollama/qwen2.5:3b
LLM_FALLBACK_API_BASE=http://ollama:11434
LLM_FALLBACK_API_KEY=ollama

LLM_TIMEOUT_SECONDS=30
LLM_FALLBACK_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
LLM_MAX_INPUT_TOKENS=8000
LLM_MAX_OUTPUT_TOKENS=1000

# --- 7. ML Batch Pipeline Parameters -----------------------------------------
LEARNGUARD_CUTOFF_DAY=27
